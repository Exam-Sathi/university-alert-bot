# Copy this file to `.env` for local testing. `.env` is ignored by git — never commit it.
# On GitHub, the same names are stored as Actions secrets (Settings → Secrets and variables → Actions).

# Google AI Studio key used to write the posts
GEMINI_API_KEY=

# Blogger → Settings → Email → "Publish using email": the secret address ending @blogger.com
BLOGGER_EMAIL=

# The Gmail address that sends those posting emails
SENDER_GMAIL=

# Google Account → Security → 2-Step Verification → App passwords (16 letters, no spaces)
GMAIL_APP_PASS=

# Public alert channel: the bot token from @BotFather, and the channel (e.g. @examsathialert).
# The bot must be an admin of that channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — Green API for posting to the WhatsApp channel. Leave empty to skip WhatsApp.
WHATSAPP_INSTANCE_ID=
WHATSAPP_API_TOKEN=

# Optional — a private Telegram bot and chat that receive failure reports.
ADMIN_TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=
